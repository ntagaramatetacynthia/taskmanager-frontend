# Option 1: Use full DATABASE_URL (Render/Heroku/Railway)
DATABASE_URL=postgresql://taskmanager_koer_user:RQgbBJfLYVKGx1T1H8KzX1fJ0lkZRrqL@dpg-dbh1tegm7kps73f219hg-a.ohio-postgres.render.com/taskmanager_koer

# Option 2: Individual credentials (local dev)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=rwanda_task_management
# DB_USERNAME=postgres
# DB_PASSWORD=your_password
# DB_DIALECT=postgres

# JWT
JWT_SECRET=your_super_secret_key_min_32_chars
JWT_EXPIRES_IN=7d

# Server
PORT=3000
NODE_ENV=production

# Email (optional)
# With all three of HOST/USER/PASS set, mail is delivered for real.
# With EMAIL_USER/EMAIL_PASS empty in development, mail is sent to an Ethereal test inbox
# and a preview URL is logged instead of being dropped silently.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
# Sender override, defaults to EMAIL_USER
# EMAIL_FROM=no-reply@yourdomain.rw
# Set to false to turn off the Ethereal fallback and skip email entirely in development
# EMAIL_DEV_PREVIEW=true

# Org code prefix
ORG_CODE_PREFIX=RW

# Parent portal: MUST differ from JWT_SECRET so parent tokens are rejected by staff/student routes
PARENT_JWT_SECRET=change-me-to-a-different-long-random-string
PARENT_JWT_EXPIRES_IN=1d
